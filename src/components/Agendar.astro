---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { waBase } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="agendar">
  <div class="wrap center">
    <span class="eyebrow reveal">{t.agendar.eyebrow}</span>
    <h2 class="reveal" style="font-size:clamp(2rem,4vw,2.7rem)">{t.agendar.title}</h2>
    <p class="reveal" style="color:var(--tinta-soft); max-width:520px; margin:14px auto 0">{t.agendar.lead}</p>

    <form class="book-card reveal" id="book-form" data-wa-base={waBase} data-wa-labels={JSON.stringify(t.agendar.waLabels)} style="text-align:left">
      <div class="field">
        <label>{t.agendar.nombre}</label>
        <input type="text" name="nombre" placeholder={t.agendar.nombrePh} required />
      </div>
      <div class="field-row">
        <div class="field">
          <label>{t.agendar.modalidad}</label>
          <select name="modalidad" required>
            <option value="" disabled selected>{t.agendar.modalidadPlaceholder}</option>
            {t.agendar.modalidadOpts.map((o) => <option>{o}</option>)}
          </select>
        </div>
        <div class="field">
          <label>{t.agendar.idioma}</label>
          <select name="idioma" required>
            {t.agendar.idiomaOpts.map((o) => <option>{o}</option>)}
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>{t.agendar.fecha}</label>
          <input type="date" name="fecha" required />
        </div>
        <div class="field">
          <label>{t.agendar.hora}</label>
          <input type="time" name="hora" required />
        </div>
      </div>
      <div class="field">
        <label>{t.agendar.motivo}</label>
        <textarea name="motivo" rows="3" placeholder={t.agendar.motivoPh}></textarea>
      </div>
      <button type="submit" class="btn btn-wsp">{t.agendar.submit}</button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('book-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const waBase = form.dataset.waBase || '';
    const L = JSON.parse(form.dataset.waLabels || '{}');
    const get = (n: string) => (f.elements.namedItem(n) as HTMLInputElement | null)?.value || '';
    const msg =
`${L.intro}

👤 ${L.nombre}: ${get('nombre')}
📍 ${L.modalidad}: ${get('modalidad')}
🗣️ ${L.idioma}: ${get('idioma')}
📅 ${L.dia}: ${get('fecha')}
⏰ ${L.hora}: ${get('hora')}
📝 ${L.detalle}: ${get('motivo') || '—'}

${L.cierre}`;
    window.open(`${waBase}?text=${encodeURIComponent(msg)}`, '_blank');
  });
</script>
