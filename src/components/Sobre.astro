---
import { Image } from 'astro:assets';
import franImg from '../assets/fran.jpg';
import { useTranslations, waGreeting } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const wsp = waGreeting(site.whatsapp, lang);
---

<section id="sobre" class="section-soft">
  <div class="wrap about">
    <div class="about-photo reveal">
      <Image src={franImg} alt={t.sobre.photoAlt} widths={[340, 680]} sizes="(max-width: 880px) 340px, 45vw" />
    </div>
    <div class="reveal">
      <span class="eyebrow">{t.sobre.eyebrow}</span>
      <h2>{t.sobre.title}</h2>
      <p>{t.sobre.p1}</p>
      <p class="quote">{t.sobre.quote}</p>
      <p>{t.sobre.p2}</p>
      <div class="hero-badges" style="margin:0 0 26px">
        {t.sobre.especialidades.map((e) => <span class="chip">{e}</span>)}
      </div>
      <a class="btn btn-soft" href={wsp}>{t.sobre.cta}</a>
    </div>
  </div>
</section>
