---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site, igUrl } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="videos" class="section-soft">
  <div class="wrap center">
    <span class="eyebrow reveal">{t.videos.eyebrow}</span>
    <h2 class="reveal section-title">{t.videos.title}</h2>
    <p class="reveal section-lead">{t.videos.lead}</p>
    <div class="videos">
      {site.videos.map((v) => (
        v.src ? (
          <div class="reel">
            <video src={v.src} poster={v.poster} controls playsinline preload="metadata"></video>
          </div>
        ) : v.url ? (
          <div class="reel" data-reel={v.url} tabindex="0" role="button" aria-label={`${v.titulo[lang]} — ${t.videos.verReel}`}>
            <div class="ph"><div class="play" aria-hidden="true">&#9654;</div><strong>{v.titulo[lang]}</strong><small>{t.videos.verReel}</small></div>
          </div>
        ) : (
          <a class="reel" href={igUrl} target="_blank">
            <div class="ph"><div class="play">&#9654;</div><strong>{v.titulo[lang]}</strong><small>{t.videos.verIg}</small></div>
          </a>
        )
      ))}
    </div>
    <div class="ig-cta reveal"><a class="btn btn-soft" href={igUrl} target="_blank">{t.videos.cta}</a></div>
  </div>
</section>

<script>
  // Carga diferida de reels de Instagram: el primer clic inserta el iframe.
  document.querySelectorAll<HTMLElement>('.reel[data-reel]').forEach((card) => {
    const load = () => {
      const url = card.dataset.reel;
      if (!url) return;
      const embed = url.replace(/\/?$/, '/') + 'embed';
      card.innerHTML = `<iframe src="${embed}" allowtransparency="true" allowfullscreen loading="lazy" title="Instagram reel"></iframe>`;
    };
    card.addEventListener('click', load, { once: true });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
    });
  });
</script>
