---
import { Image } from 'astro:assets';
import franImg from '../assets/fran.jpg';
import { useTranslations, waGreeting } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const wsp = waGreeting(site.whatsapp, lang);
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="reveal">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1>{t.hero.title} <em>{t.hero.titleEm}</em></h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="hero-cta">
        <a class="btn btn-wsp" href={wsp}>{t.hero.ctaWsp}</a>
        <a class="btn btn-soft" href="#horarios">{t.hero.ctaSoft}</a>
      </div>
      <div class="hero-badges">
        {t.hero.chips.map((c) => <span class="chip">{c}</span>)}
      </div>
    </div>

    <div class="hero-photo reveal">
      <div class="blob">
        <Image src={franImg} alt={t.hero.photoAlt} widths={[420, 840]} sizes="(max-width: 880px) 80vw, 420px" />
      </div>
      <div class="float-tag t1"><span class="dot"></span> {t.hero.tag1}</div>
      <div class="float-tag t2">{t.hero.tag2}</div>
    </div>
  </div>
</section>
