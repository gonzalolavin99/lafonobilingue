---
import { useTranslations, waGreeting } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site, igUrl } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const wsp = waGreeting(site.whatsapp, lang);
const year = new Date().getFullYear();
---

<footer id="contacto">
  <div class="wrap">
    <h2>{t.footer.title}</h2>
    <p>{t.footer.text}</p>
    <div class="social">
      <a href={wsp} title={t.footer.wspTitle}>💬</a>
      <a href={igUrl} target="_blank" title={t.footer.igTitle}>📸</a>
    </div>
    <p class="copyright">© {year} {t.footer.copyright}</p>
  </div>
</footer>
