---
import { useTranslations, waGreeting } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { site } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const wsp = waGreeting(site.whatsapp, lang);
---

<section id="como-funciona">
  <div class="wrap center">
    <span class="eyebrow reveal">{t.como.eyebrow}</span>
    <h2 class="reveal" style="font-size:clamp(2rem,4vw,2.7rem)">{t.como.title}</h2>
    <p class="reveal" style="color:var(--tinta-soft); max-width:480px; margin:14px auto 0">{t.como.lead}</p>
    <div class="steps reveal">
      {t.como.pasos.map((p, i) => (
        <div class="step">
          <div class="num">{i + 1}</div>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      ))}
    </div>
    <div class="center" style="margin-top:36px"><a class="btn btn-wsp" href={wsp}>{t.como.cta}</a></div>
  </div>
</section>
