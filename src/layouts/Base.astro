---
import '../styles/global.css';
import { ui, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = defaultLang as Lang } = Astro.props;
const meta = ui[lang].meta;
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;

const ogImage = new URL('/og.png', Astro.site).href;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const esUrl = Astro.site ? new URL('/', Astro.site).href : '/';
const enUrl = Astro.site ? new URL('/en/', Astro.site).href : '/en/';
const ogLocale = lang === 'en' ? 'en_US' : 'es_CL';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={esUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/og.png" />

  <!-- Tarjeta de previsualización al compartir el link (Open Graph + Twitter) -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Francisca Valenzuela, fonoaudióloga bilingüe" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:site_name" content="La fono bilingüe" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fuentes: Fraunces (titulares) + Poppins (cuerpo) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Poppins:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <slot />
</body>
</html>
